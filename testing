        function exportTable(tableId, filename, format) {
            const table = document.getElementById(tableId);
            if (!table) return;

            if (format === 'csv') {
                let csv = [];
                const rows = table.querySelectorAll('tr');
                for (let i = 0; i < rows.length; i++) {
                    let row = [], cols = rows[i].querySelectorAll('td, th');
                    for (let j = 0; j < cols.length; j++) {
                        const cb = cols[j].querySelector('input[type="checkbox"]');
                        let txt = cb ? (cb.checked ? 'V' : '-') : cols[j].innerText;
                        row.push('"' + txt.replace(/"/g, '""').trim() + '"');
                    }
                    csv.push(row.join(','));
                }
                let blob = new Blob([csv.join('\n')], { type: 'text/csv' });
                let link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = filename + '.csv';
                link.click();
                showToast('Tabel berhasil diunduh ke format Spreadsheet/CSV.');
            } else if (format === 'doc') {
                let html = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>${filename}</title></head><body>${table.outerHTML}</body></html>`;
                let blob = new Blob(['\ufeff' + html], { type: 'application/msword' });
                let link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = filename + '.doc';
                link.click();
                showToast('Tabel berhasil diunduh ke format Word (.doc).');
            }
        }

        function exportDataJSON() {
            let blob = new Blob([JSON.stringify(appState, null, 2)], { type: 'application/json' });
            let link = document.createElement('a');
            link.href = window.URL.createObjectURL(blob);
            link.download = 'Backup_Database_CRC.json';
            link.click();
            showToast('Database JSON berhasil diunduh.');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function showToast(msg) {
            const c = document.getElementById('toastContainer');
            const el = document.createElement('div');
            el.className = "bg-slate-900 text-white px-4 py-3 rounded-2xl shadow-2xl text-xs font-bold transition duration-300 flex items-center gap-2 border border-slate-800";
            el.innerHTML = `<i class="fa-solid fa-circle-info text-amber-400"></i> ${msg}`;
            c.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
