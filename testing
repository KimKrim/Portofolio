            appState.finance.forEach(f => {
                if (f.type === 'in') tIn += f.amount; else tOut += f.amount;
            });
            document.getElementById('statKeuangan').innerText = `Rp ${(tIn - tOut).toLocaleString('id-ID')}`;

            const ctx = document.getElementById('financeChart').getContext('2d');
            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Pemasukan Kas & Support', 'Pengeluaran Organisasi', 'Sisa Saldo Kas'],
                    datasets: [{
                        label: 'Jumlah (Rp)',
                        data: [tIn, tOut, tIn - tOut],
                        backgroundColor: ['#10b981', '#f43f5e', '#3b82f6'],
                        borderRadius: 8
