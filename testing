<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRC Management Portal - MPK System</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        crc: {
                            navy: '#0b132b',
                            dark: '#1c2541',
                            blue: '#3a506b',
                            accent: '#e11d48',
                            gold: '#f59e0b'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom CSS Styles -->
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        }
        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }
        
        .custom-scroll::-webkit-scrollbar { height: 8px; width: 8px; }
        .custom-scroll::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white; color: black; }
            .glass-card { border: none; box-shadow: none; }
        }
    </style>
</head>
<body class="h-full flex flex-col antialiased text-slate-800 bg-slate-50">

    <div id="toastContainer" class="fixed top-5 right-5 z-[100] flex flex-col gap-2 pointer-events-none"></div>

    <div id="loginOverlay" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-[90] flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-8 shadow-2xl relative border border-slate-100">
            <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-red-600 via-amber-500 to-blue-600 rounded-t-3xl"></div>
            
            <div class="text-center mb-8 mt-2">
                <!-- SVG Logo CRC Official -->
                <div class="w-28 h-28 mx-auto mb-3 drop-shadow-md">
                    <svg viewBox="0 0 200 210" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                        <polygon points="10,55 100,12 190,55" fill="none" stroke="#0f172a" stroke-width="4"/>
                        <polygon points="22,53 100,19 178,53" fill="none" stroke="#0f172a" stroke-width="2"/>
                        <path d="M 100,22 C 90,32 90,46 100,50 C 110,46 110,32 100,22 Z" fill="#16a34a"/>
                        <path d="M 94,36 C 85,28 100,20 106,32 C 100,38 96,38 94,36 Z" fill="#2563eb"/>
                        <path d="M 100,26 C 108,32 104,44 98,42 Z" fill="#eab308"/>
                        <line x1="20" y1="57" x2="180" y2="57" stroke="#0f172a" stroke-width="4"/>
                        <rect x="88" y="57" width="24" height="73" fill="#facc15" stroke="#0f172a" stroke-width="1.5"/>
                        <line x1="32" y1="57" x2="14" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <line x1="32" y1="57" x2="50" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <polygon points="8,98 56,98 32,108" fill="#0f172a"/>
                        <line x1="168" y1="57" x2="150" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <line x1="168" y1="57" x2="186" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <polygon points="144,98 192,98 168,108" fill="#0f172a"/>
                        <path d="M 42,126 A 62,52 0 0,1 158,126" fill="none" stroke="#2563eb" stroke-width="15" stroke-linecap="round"/>
                        <text x="100" y="122" font-family="'Times New Roman', serif" font-weight="900" font-size="30" fill="#0f172a" text-anchor="middle" letter-spacing="1">CRC</text>
                        <rect x="48" y="130" width="104" height="21" fill="#dc2626"/>
                        <text x="100" y="145" font-family="sans-serif" font-weight="900" font-size="11" fill="#ffffff" text-anchor="middle" letter-spacing="2">CLASS</text>
                        <rect x="32" y="151" width="136" height="21" fill="#dc2626"/>
                        <text x="100" y="166" font-family="sans-serif" font-weight="900" font-size="10" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">REPRESENTATIVE</text>
                        <rect x="16" y="172" width="168" height="23" fill="#dc2626"/>
                        <text x="100" y="188" font-family="sans-serif" font-weight="900" font-size="10.5" fill="#ffffff" text-anchor="middle" letter-spacing="1">CONFERENCE</text>
                    </svg>
                </div>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">CRC MANAGEMENT PORTAL</h2>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">Class Representative Conference • MPK System</p>
                <div class="inline-block mt-2 bg-slate-100 text-slate-600 text-[10px] font-semibold px-3 py-1 rounded-full border border-slate-200">
                    Naungan: SOGIBS & CBP
                </div>
            </div>

            <form id="loginForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Username Akun</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </span>
                        <input type="text" id="loginUser" required placeholder="Masukkan Username..." class="w-full pl-10 pr-4 py-3 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-rose-500 focus:border-rose-500 outline-none transition bg-slate-50">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input type="password" id="loginPass" required placeholder="Masukkan Password..." class="w-full pl-10 pr-4 py-3 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-rose-500 focus:border-rose-500 outline-none transition bg-slate-50">
                    </div>
                </div>
                <button type="submit" class="w-full bg-slate-900 hover:bg-rose-600 text-white font-bold text-sm py-3.5 rounded-xl transition shadow-lg hover:shadow-rose-500/25 mt-2 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i> Masuk Ke Portal CRC
                </button>
            </form>

            <div class="mt-6 text-center text-slate-400 text-[11px] font-medium border-t border-slate-100 pt-4">
                Masa Bakti 2026/2027 • Sistem MPK Terpadu
            </div>
        </div>
    </div>

    <header class="bg-slate-900 text-white sticky top-0 z-40 no-print border-b border-slate-800">
        <div class="max-w-[1400px] mx-auto px-4 lg:px-8 flex items-center justify-between h-20">
            <!-- Brand -->
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-md p-1 border border-slate-700">
                    <svg viewBox="0 0 200 210" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
                        <polygon points="10,55 100,12 190,55" fill="none" stroke="#0f172a" stroke-width="4"/>
                        <polygon points="22,53 100,19 178,53" fill="none" stroke="#0f172a" stroke-width="2"/>
                        <path d="M 100,22 C 90,32 90,46 100,50 C 110,46 110,32 100,22 Z" fill="#16a34a"/>
                        <path d="M 94,36 C 85,28 100,20 106,32 C 100,38 96,38 94,36 Z" fill="#2563eb"/>
                        <path d="M 100,26 C 108,32 104,44 98,42 Z" fill="#eab308"/>
                        <line x1="20" y1="57" x2="180" y2="57" stroke="#0f172a" stroke-width="4"/>
                        <rect x="88" y="57" width="24" height="73" fill="#facc15" stroke="#0f172a" stroke-width="1.5"/>
                        <line x1="32" y1="57" x2="14" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <line x1="32" y1="57" x2="50" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <polygon points="8,98 56,98 32,108" fill="#0f172a"/>
                        <line x1="168" y1="57" x2="150" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <line x1="168" y1="57" x2="186" y2="98" stroke="#0f172a" stroke-width="1.5"/>
                        <polygon points="144,98 192,98 168,108" fill="#0f172a"/>
                        <path d="M 42,126 A 62,52 0 0,1 158,126" fill="none" stroke="#2563eb" stroke-width="15" stroke-linecap="round"/>
                        <text x="100" y="122" font-family="'Times New Roman', serif" font-weight="900" font-size="30" fill="#0f172a" text-anchor="middle" letter-spacing="1">CRC</text>
                        <rect x="48" y="130" width="104" height="21" fill="#dc2626"/>
                        <text x="100" y="145" font-family="sans-serif" font-weight="900" font-size="11" fill="#ffffff" text-anchor="middle" letter-spacing="2">CLASS</text>
                        <rect x="32" y="151" width="136" height="21" fill="#dc2626"/>
                        <text x="100" y="166" font-family="sans-serif" font-weight="900" font-size="10" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">REPRESENTATIVE</text>
                        <rect x="16" y="172" width="168" height="23" fill="#dc2626"/>
                        <text x="100" y="188" font-family="sans-serif" font-weight="900" font-size="10.5" fill="#ffffff" text-anchor="middle" letter-spacing="1">CONFERENCE</text>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-black tracking-tight text-white">CRC PORTAL</h1>
                        <span class="text-[9px] font-black bg-rose-600 text-white px-2.5 py-0.5 rounded-full uppercase tracking-wider">MASA BAKTI 2026/2027</span>
                    </div>
                    <p class="text-[11px] text-slate-400 font-medium">Class Representative Conference • MPK System</p>
                </div>
            </div>

            <!-- Right Controls -->
            <div class="flex items-center gap-3">
                <button onclick="openImportModal()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-file-import"></i> <span class="hidden sm:inline">Import Sheets</span>
                </button>
                
                <div class="flex items-center gap-3 bg-slate-800 border border-slate-700 px-3.5 py-1.5 rounded-xl">
                    <div class="w-8 h-8 rounded-lg bg-rose-600 flex items-center justify-center text-white font-bold text-xs shadow">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div class="text-left hidden md:block">
                        <p id="hUserName" class="text-xs font-bold text-white leading-tight">Nama Pengurus</p>
                        <p id="hUserRole" class="text-[10px] font-bold text-amber-400">Jabatan Role</p>
                    </div>
                </div>

                <button onclick="logout()" title="Keluar Akun" class="w-10 h-10 bg-slate-800 hover:bg-rose-600 text-slate-300 hover:text-white rounded-xl flex items-center justify-center transition border border-slate-700">
                    <i class="fa-solid fa-power-off text-sm"></i>
                </button>
            </div>
        </div>

        <div class="bg-slate-950 border-t border-slate-800/80 px-4 lg:px-8">
            <div class="max-w-[1400px] mx-auto flex gap-1.5 overflow-x-auto py-2 hide-scroll" id="navContainer">
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-[1400px] w-full mx-auto px-4 lg:px-8 py-6 no-print">

        <!-- Role Context Banner -->
        <div id="roleBanner" class="mb-6 bg-rose-50 border border-rose-200 rounded-2xl p-4 flex items-center gap-4 shadow-sm">
            <div class="w-10 h-10 bg-rose-100 rounded-xl flex items-center justify-center text-rose-600 font-bold shrink-0">
                <i id="bannerIcon" class="fa-solid fa-shield-halved text-lg"></i>
            </div>
            <div>
                <h3 id="bannerTitle" class="text-sm font-bold text-slate-800">Akses User Logged In</h3>
                <p id="bannerDesc" class="text-xs text-slate-600 mt-0.5">Penjelasan hak akses divisi dalam sistem CRC.</p>
            </div>
            <div class="ml-auto shrink-0">
                <span id="bannerBadge" class="bg-emerald-100 text-emerald-800 px-3 py-1 rounded-lg text-xs font-bold border border-emerald-200 inline-flex items-center gap-1.5">
                    <i class="fa-solid fa-lock-open"></i> <span id="bannerBadgeText">Akses Aktif</span>
                </span>
            </div>
        </div>

        <section id="view-dashboard" class="tab-view space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-card p-5 border-l-4 border-l-blue-600">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Total Pengurus Aktif</p>
                    <h3 id="statPengurus" class="text-2xl font-black text-slate-800 mt-1">18 Anggota</h3>
                    <p class="text-[11px] text-slate-500 mt-1">Siswa Kelas XI & X (18 Pengurus)</p>
                </div>
                <div class="glass-card p-5 border-l-4 border-l-emerald-600">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Total Keuangan Kas</p>
                    <h3 id="statKeuangan" class="text-2xl font-black text-slate-800 mt-1">Rp 1.613.200</h3>
                    <p class="text-[11px] text-emerald-600 font-semibold mt-1"><i class="fa-solid fa-circle-check"></i> Kas Terkumpul Lengkap</p>
                </div>
                <div class="glass-card p-5 border-l-4 border-l-rose-600">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Rapat Terawasi</p>
                    <h3 id="statRapat" class="text-2xl font-black text-slate-800 mt-1">0 Rapat</h3>
                    <p class="text-[11px] text-slate-500 mt-1">Laporan Tim Supervisor</p>
                </div>
                <div class="glass-card p-5 border-l-4 border-l-amber-500">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Surat Terbit</p>
                    <h3 id="statSurat" class="text-2xl font-black text-slate-800 mt-1">0 Surat</h3>
                    <p class="text-[11px] text-slate-500 mt-1">Arsip Sekretariat CRC</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="glass-card p-6 lg:col-span-2">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-emerald-600"></i> Neraca Keuangan & Kas Organisasi
                        </h3>
                        <span class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-lg font-medium">Grafik Real-time</span>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="financeChart"></canvas>
                    </div>
                </div>

                <div class="glass-card p-6 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800 text-sm mb-3 flex items-center gap-2">
                            <i class="fa-solid fa-sitemap text-indigo-600"></i> Naungan Organisasi CRC
                        </h3>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            CRC (Class Representative Conference) bertindak sebagai badan perwakilan kelas (setara MPK) yang mengawasi dan menaungi dua organisasi utama:
                        </p>
                        <div class="space-y-3">
                            <div class="p-3 bg-blue-50 border border-blue-200 rounded-xl">
                                <h4 class="font-bold text-xs text-blue-900">1. SOGIBS</h4>
                                <p class="text-[11px] text-blue-700">Student Organization Global Islamic Boarding School</p>
                            </div>
                            <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl">
                                <h4 class="font-bold text-xs text-amber-900">2. CBP</h4>
                                <p class="text-[11px] text-amber-700">Community Based Project</p>
                            </div>
                        </div>
                    </div>
                    <div class="pt-4 border-t border-slate-100 text-[11px] text-slate-400 text-center">
                        Pengawasan Rapat & Evaluasi Kinerja Berkala
                    </div>
                </div>
            </div>
        </section>

        <section id="view-struktur" class="tab-view hidden space-y-6">
            <div class="glass-card p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-sitemap text-indigo-600"></i> Struktur Keanggotaan Organisasi CRC (Kelas XI-X)
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Daftar hirarki struktur pengurus Tim Inti, Kepengawasan, Kesekretariat, Kearsipan, dan Aspirasi.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="openImportModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition flex items-center gap-2 shadow">
                        <i class="fa-solid fa-file-excel"></i> Copy-Paste dari Google Sheets
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-5 gap-4" id="divisiSummaryGrid"></div>

            <div class="glass-card overflow-hidden">
                <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-white">
                    <h3 class="font-bold text-sm text-slate-800" id="txtMemberCount">Direktori Anggota Pengurus CRC</h3>
                    <div class="relative w-full sm:w-72">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        </span>
                        <input type="text" id="searchMember" onkeyup="filterMembers()" placeholder="Cari nama anggota / divisi..." class="w-full pl-9 pr-3 py-1.5 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500">
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-900 text-white uppercase text-[9px] tracking-wider">
                            <tr>
                                <th class="p-3.5">Nama Lengkap Anggota</th>
                                <th class="p-3.5">Divisi / Bidang</th>
                                <th class="p-3.5">Jabatan Struktural</th>
                                <th class="p-3.5 text-center">Status Keanggotaan</th>
                                <th class="p-3.5 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="strukturTbody" class="divide-y divide-slate-100 bg-white"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="view-supervisor" class="tab-view hidden space-y-6">
            <div class="glass-card p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-clipboard-list text-rose-600"></i> Pelaporan Tim Supervisor Pengawasan Rapat
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Khusus tim Kepengawasan/Supervisor untuk mencatat, mengawasi, dan mengevaluasi rapat organisasi.</p>
                </div>
                <button id="btnOpenSupModal" onclick="openSupModal()" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
                    <i class="fa-solid fa-plus"></i> Input Laporan Pengawasan Rapat
                </button>
            </div>

            <div class="glass-card overflow-hidden">
                <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-3 bg-white">
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <input type="text" id="searchSup" onkeyup="filterSup()" placeholder="Cari nama rapat / supervisor..." class="px-3 py-1.5 border border-slate-200 rounded-xl text-xs w-full sm:w-64 outline-none focus:border-rose-500">
                    </div>
                    <button onclick="exportTable('tableSupervisor', 'Laporan_Pengawasan_Rapat_CRC', 'csv')" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs px-3 py-1.5 rounded-lg border border-slate-200 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-download text-xs"></i> Export Laporan
                    </button>
                </div>
                <div class="overflow-x-auto" id="tableSupervisor">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-900 text-white uppercase text-[9px] tracking-wider">
                            <tr>
                                <th class="p-3.5">Tanggal</th>
                                <th class="p-3.5">Nama / Agenda Rapat</th>
                                <th class="p-3.5">Divisi / Bidang Terawas</th>
                                <th class="p-3.5">Supervisor Pengawas</th>
                                <th class="p-3.5 text-center">Kehadiran</th>
                                <th class="p-3.5 text-center">Status Evaluasi</th>
                                <th class="p-3.5 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="supTbody" class="divide-y divide-slate-100 bg-white"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="view-raport" class="tab-view hidden space-y-6">
            <div class="glass-card p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-graduation-cap text-blue-600"></i> Manajemen & Upload Raport Organisasi CRC
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Modul Tim Kesekretariat untuk menyusun, mengkalkulasi, dan merilis nilai raport kinerja per bidang/divisi.</p>
                </div>
                <button id="btnOpenRaportModal" onclick="openRaportModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i> Buat Raport Baru
